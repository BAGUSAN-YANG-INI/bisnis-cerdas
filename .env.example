# ==============================================================================
# Environment Configuration - UMKM Financial Health Platform
# Salin file ini menjadi .env sebelum menjalankan docker compose:
# cp .env.example .env
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=bisnis-cerdas

# Exposed Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=3306

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bisnis_cerdas
DB_USERNAME=bisnis_user
DB_PASSWORD=bisnis_secret_password
DB_ROOT_PASSWORD=root_secret_password

# Frontend Environment
VITE_API_URL=http://localhost:8000/api
